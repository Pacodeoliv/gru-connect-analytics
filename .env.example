# ============================================================
# GRU Connect Analytics — Environment Variables
# ============================================================
# Copie para .env e ajuste os valores para sua máquina:
#   cp .env.example .env

# Diretório raiz do projeto (sem barra no final)
GRU_BASE_DIR=/workspace/gru-connect-analytics

# Airflow
AIRFLOW_HOME=/workspace/gru-connect-analytics/airflow

# Ingestão ANAC (mês/ano de referência para backfill manual)
ANAC_ANO=2025
ANAC_MES=01
