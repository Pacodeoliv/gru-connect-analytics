# ============================================================
# GRU Connect Analytics — Environment Variables
# ============================================================
# Copie para .env e ajuste os valores para sua máquina:
#   cp .env.example .env

# ── Execução Local (sem Docker) ──────────────────────────────
# Diretório raiz do projeto (sem barra no final)
GRU_BASE_DIR=/workspace/gru-connect-analytics

# ── Execução com Docker Compose ──────────────────────────────
# Dentro dos containers, o projeto está montado em /opt/airflow
# GRU_BASE_DIR=/opt/airflow   ← use este em produção Docker

# UID do seu usuário Linux (evita problemas de permissão nos volumes)
# Descubra com: echo $(id -u)
AIRFLOW_UID=50000

# Senha do Postgres (metastore do Airflow)
POSTGRES_PASSWORD=airflow

# Airflow
AIRFLOW_HOME=/workspace/gru-connect-analytics/airflow

# ── Ingestão ANAC (backfill manual) ──────────────────────────
ANAC_ANO=2025
ANAC_MES=01


# Airflow
AIRFLOW_HOME=/workspace/gru-connect-analytics/airflow

# Ingestão ANAC (mês/ano de referência para backfill manual)
ANAC_ANO=2025
ANAC_MES=01
