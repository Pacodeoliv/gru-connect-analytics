# ============================================================
# GRU Connect Analytics — Environment Variables
# ============================================================
# Copy to .env and adjust values for your machine:
#   cp .env.example .env

# ── Docker Compose ───────────────────────────────────────────
# UID of your Linux user (avoids permission issues with volumes)
# Find yours with: echo $(id -u)
AIRFLOW_UID=1000

# Postgres password (Airflow metastore)
POSTGRES_PASSWORD=airflow

# Project root inside the container (do not change)
GRU_BASE_DIR=/opt/airflow

# ── ANAC Ingestion (month/year reference for backfill) ───────
ANAC_ANO=2025
ANAC_MES=01
